APPLE_SERVER_AUTH_ENABLED=0
APPLE_TEAM_ID=YOUR_APPLE_TEAM_ID
APPLE_CLIENT_ID=YOUR_SERVICES_ID
APPLE_KEY_ID=YOUR_APPLE_KEY_ID
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----"

APPLE_PRIVATE_KEY_PATH=
APPLE_REDIRECT_URI=https://api.plancraftai.com/api/auth/apple/callback
FIREBASE_API_KEY=YOUR_FIREBASE_WEB_API_KEY

# Product analytics (server-side funnel events: reminder_created, reminder_delivered, subscription_started).
# Same project token as the frontend VITE_MIXPANEL_TOKEN. Leave empty to disable.
MIXPANEL_TOKEN=
# Optional: https://api-eu.mixpanel.com for EU data residency projects.
# MIXPANEL_API_HOST=https://api.mixpanel.com

# Stripe personal pricing. STRIPE_MONTHLY_PRICE_ID should be the regular
# $5.00/month recurring price. The founding price is optional and is only
# accepted while the enabled flag is on and the end date is in the future.
STRIPE_MONTHLY_PRICE_ID=price_your_regular_5_monthly_price
STRIPE_YEARLY_PRICE_ID=price_your_regular_49_yearly_price
STRIPE_FOUNDING_MONTHLY_PRICE_ID=price_your_founding_2_monthly_price
STRIPE_FOUNDING_OFFER_ENABLED=0
STRIPE_FOUNDING_OFFER_END_AT=2026-12-31T23:59:59Z

# Cheap-by-default task parsing. The server tries the local parser first, then
# Gemini, then Groq. OpenAI and OpenRouter are intentionally opt-in so free or
# paid fallback behavior never changes without an explicit deployment decision.
# Add openrouter for experiments, or openai as a paid last resort when needed.
# Review each provider's data-use policy before routing personal task text to it.
AI_TASK_PROVIDER_ORDER=gemini,groq
AI_TASK_PROVIDER_TIMEOUT_MS=15000
GEMINI_API_KEY=
GEMINI_TASK_MODEL=gemini-2.5-flash-lite
GROQ_API_KEY=
GROQ_TASK_MODEL=openai/gpt-oss-20b
OPENROUTER_API_KEY=
OPENROUTER_TASK_MODEL=openrouter/free
# Optional provider orders:
# AI_TASK_PROVIDER_ORDER=gemini,groq,openrouter
# AI_TASK_PROVIDER_ORDER=gemini,groq,openai
OPENAI_TASK_MODEL=gpt-4o-mini

# Personal Intelligence Desk. This path intentionally uses OpenAI Responses
# web_search for live, source-backed research and is separate from task parsing.
# GPT-5.4 Mini is the cost-optimized default; use gpt-5.5 for maximum depth.
OPENAI_INTELLIGENCE_MODEL=gpt-5.4-mini
# Compatibility fallback only when Responses web_search is unsupported.
OPENAI_INTELLIGENCE_SEARCH_MODEL=gpt-5-search-api
# Cheap editor pass over the source-backed specialist packets.
OPENAI_INTELLIGENCE_SUMMARY_MODEL=gpt-4.1-mini
# Shared Firestore and in-process cache lifetime. This avoids paying for the same
# source-backed specialist research across users or backend instances.
INTELLIGENCE_CACHE_TTL_MS=3600000
# Premium users only; cached responses do not consume this quota. A run is a
# complete Intelligence research request, not an individual web result.
INTELLIGENCE_PREMIUM_REQUESTS_PER_MONTH=30
# Short-lived cache for repeated workspace/task-planning summaries. This also
# collapses identical concurrent requests before they reach a model provider.
WORKSPACE_SUMMARY_CACHE_TTL_MS=300000
# Keep task-help requests bounded; the client also falls back to local steps.
WORKSPACE_SUMMARY_TIMEOUT_MS=12000
# Maximum number of private user-created research desks.
INTELLIGENCE_CUSTOM_AGENTS_LIMIT=10
# Morning email delivery is opt-in at two levels: this server flag and each
# user's individual desk schedule. Keep disabled until email delivery is verified.
ENABLE_INTELLIGENCE_MORNING_EMAILS=0
INTELLIGENCE_MORNING_EMAIL_CRON=*/5 * * * *
INTELLIGENCE_MORNING_EMAIL_MAX_AGENTS_PER_USER=3
INTELLIGENCE_APP_URL=https://plancraftai.com/intelligence
# Configure one existing email provider before enabling morning delivery.
EMAIL_PROVIDER=sendgrid
EMAIL_FROM=
SENDGRID_API_KEY=
# For SES instead: EMAIL_PROVIDER=ses, AWS_SES_REGION=us-east-1, and AWS
# credentials available to the backend runtime.
# AWS_SES_REGION=

# Keep ordinary task creation local/cheap unless these opt-in fallbacks are enabled.
ENABLE_AI_CATEGORY_FALLBACK=0
ENABLE_AI_TIME_FALLBACK=0

# Optional per-million-token rates for usage estimates in server logs.
# AI_COST_GEMINI_INPUT_PER_MILLION=0
# AI_COST_GEMINI_OUTPUT_PER_MILLION=0
# AI_COST_GROQ_INPUT_PER_MILLION=0
# AI_COST_GROQ_OUTPUT_PER_MILLION=0
# AI_COST_OPENROUTER_INPUT_PER_MILLION=0
# AI_COST_OPENROUTER_OUTPUT_PER_MILLION=0
# AI_COST_OPENAI_INPUT_PER_MILLION=
# AI_COST_OPENAI_OUTPUT_PER_MILLION=
