APPLE_SERVER_AUTH_ENABLED=0
APPLE_TEAM_ID=YOUR_APPLE_TEAM_ID
APPLE_CLIENT_ID=YOUR_SERVICES_ID
APPLE_KEY_ID=YOUR_APPLE_KEY_ID
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----"
APPLE_PRIVATE_KEY_PATH=
APPLE_REDIRECT_URI=https://api.plancraftai.com/api/auth/apple/callback
FIREBASE_API_KEY=YOUR_FIREBASE_WEB_API_KEY

# Product analytics (server-side funnel events: reminder_created, reminder_delivered, subscription_started).
# Same project token as the frontend VITE_MIXPANEL_TOKEN. Leave empty to disable.
MIXPANEL_TOKEN=
# Optional: https://api-eu.mixpanel.com for EU data residency projects.
# MIXPANEL_API_HOST=https://api.mixpanel.com

# Cheap-by-default task parsing. The server tries the local parser first, then
# configured providers in this order. OpenAI is intentionally not in the
# default path; add it explicitly only if you want it as a last resort.
# Review each provider's data-use policy before routing personal task text to it.
AI_TASK_PROVIDER_ORDER=gemini,groq,openrouter
AI_TASK_PROVIDER_TIMEOUT_MS=15000
GEMINI_API_KEY=
GEMINI_TASK_MODEL=gemini-2.5-flash-lite
GROQ_API_KEY=
GROQ_TASK_MODEL=openai/gpt-oss-20b
OPENROUTER_API_KEY=
OPENROUTER_TASK_MODEL=openrouter/free
# Optional last-resort provider: AI_TASK_PROVIDER_ORDER=gemini,groq,openrouter,openai
OPENAI_TASK_MODEL=gpt-4o-mini

# Keep ordinary task creation local/cheap unless these opt-in fallbacks are enabled.
ENABLE_AI_CATEGORY_FALLBACK=0
ENABLE_AI_TIME_FALLBACK=0

# Optional per-million-token rates for usage estimates in server logs.
# AI_COST_GEMINI_INPUT_PER_MILLION=0
# AI_COST_GEMINI_OUTPUT_PER_MILLION=0
# AI_COST_GROQ_INPUT_PER_MILLION=0
# AI_COST_GROQ_OUTPUT_PER_MILLION=0
# AI_COST_OPENROUTER_INPUT_PER_MILLION=0
# AI_COST_OPENROUTER_OUTPUT_PER_MILLION=0
# AI_COST_OPENAI_INPUT_PER_MILLION=
# AI_COST_OPENAI_OUTPUT_PER_MILLION=
