rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isUser(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid))
             .data.role in ['admin', 'superadmin'];
    }

    // Workspace helpers
    function memberDocId(workspaceId, uid) {
      return workspaceId + "_" + uid;
    }

    function member(workspaceId) {
      return isSignedIn()
        ? get(/databases/$(database)/documents/workspace_members/$(memberDocId(workspaceId, request.auth.uid))).data
        : null;
    }

    function isActiveMember(workspaceId) {
      return isSignedIn()
        && workspaceId is string
        && exists(/databases/$(database)/documents/workspace_members/$(memberDocId(workspaceId, request.auth.uid)))
        && member(workspaceId).status == 'active';
    }

    function roleIn(workspaceId, roles) {
      return isActiveMember(workspaceId)
        && member(workspaceId).role in roles;
    }

    function hasWorkspaceRole(workspaceId, roles) {
      return roleIn(workspaceId, roles);
    }

    function isLegacyPersonalTask(data) {
      return !(data.workspaceId is string)
        && data.userId == request.auth.uid;
    }

    // Users & Preferences
    match /users/{uid} {
      allow read: if isUser(uid) || isAdmin();
      allow create: if isUser(uid);
      allow update: if isUser(uid) || isAdmin();
      allow delete: if isAdmin();
    }

    match /preferences/{uid} {
      allow read, write: if isUser(uid) || isAdmin();
    }

    match /users/{uid}/workspaces/{workspaceId}/preferences/{prefId} {
      allow read, write: if isUser(uid) && isActiveMember(workspaceId);
    }

    // Tasks (workspace + legacy)
    match /tasks/{taskId} {
      allow create: if isSignedIn()
        && request.resource.data.workspaceId is string
        && roleIn(request.resource.data.workspaceId, ['owner', 'admin', 'editor'])
        && request.resource.data.createdBy == request.auth.uid;

      allow read: if isAdmin()
        || (resource.data.workspaceId is string && isActiveMember(resource.data.workspaceId))
        || isLegacyPersonalTask(resource.data);

      allow update: if (
        isAdmin()
        || (
          resource.data.workspaceId is string
          && request.resource.data.workspaceId is string
          && request.resource.data.workspaceId == resource.data.workspaceId
          && roleIn(resource.data.workspaceId, ['owner', 'admin', 'editor'])
        )
        || (
          !(resource.data.workspaceId is string)
          && !(request.resource.data.workspaceId is string)
          && isLegacyPersonalTask(resource.data)
        )
      )
      && (
        !(resource.data.createdBy is string)
        || request.resource.data.createdBy == resource.data.createdBy
      );

      allow delete: if isAdmin()
        || (resource.data.workspaceId is string && roleIn(resource.data.workspaceId, ['owner', 'admin']))
        || isLegacyPersonalTask(resource.data);
    }

    // Journal Entries & Links
    match /journalEntries/{id} {
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if isAdmin()
        || resource.data.userId == request.auth.uid;
    }

    match /links/{id} {
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if isAdmin()
        || resource.data.userId == request.auth.uid;
    }

    match /linksCategories/{id} {
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if isAdmin()
        || resource.data.userId == request.auth.uid;
    }

    // Napkin / Notes
    match /users/{uid}/workspaces/{workspaceId}/napkin/{itemId} {
      allow read: if isUser(uid) && isActiveMember(workspaceId);

      allow create: if isUser(uid)
        && hasWorkspaceRole(workspaceId, ['owner', 'admin', 'editor'])
        && request.resource.data.workspaceId == workspaceId;

      allow update: if isUser(uid)
        && hasWorkspaceRole(workspaceId, ['owner', 'admin', 'editor'])
        && resource.data.workspaceId == workspaceId
        && request.resource.data.workspaceId == workspaceId;

      allow delete: if isUser(uid)
        && hasWorkspaceRole(workspaceId, ['owner', 'admin', 'editor'])
        && resource.data.workspaceId == workspaceId;
    }

    match /napkin/{uid}/items/{itemId} {
      allow read, write: if isUser(uid);
    }

    // Workspace-scoped links
    match /users/{uid}/workspaces/{workspaceId}/links/{linkId} {
      allow read: if isUser(uid) && isActiveMember(workspaceId);

      allow create: if isUser(uid)
        && isActiveMember(workspaceId)
        && request.resource.data.userId == uid
        && request.resource.data.workspaceId == workspaceId;

      allow update: if isUser(uid)
        && isActiveMember(workspaceId)
        && resource.data.userId == uid
        && resource.data.workspaceId == workspaceId
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.workspaceId == resource.data.workspaceId;

      allow delete: if isUser(uid)
        && isActiveMember(workspaceId)
        && resource.data.userId == uid
        && resource.data.workspaceId == workspaceId;
    }

    match /users/{uid}/workspaces/{workspaceId}/linksCategories/{categoryId} {
      allow read: if isUser(uid) && isActiveMember(workspaceId);

      allow create: if isUser(uid)
        && isActiveMember(workspaceId)
        && request.resource.data.userId == uid
        && request.resource.data.workspaceId == workspaceId;

      allow update: if isUser(uid)
        && isActiveMember(workspaceId)
        && resource.data.userId == uid
        && resource.data.workspaceId == workspaceId
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.workspaceId == resource.data.workspaceId;

      allow delete: if isUser(uid)
        && isActiveMember(workspaceId)
        && resource.data.userId == uid
        && resource.data.workspaceId == workspaceId;
    }

    // Notifications & Blogs
    match /notifications/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /blogs/{id} {
      allow read: if resource.data.published == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Legacy user-scoped workspace docs
    match /users/{uid}/workspaces/{workspaceId} {
      allow read, create, update, delete: if isUser(uid) || isAdmin();
    }

    // Workspace Members
    match /workspace_members/{id} {
      allow read: if isSignedIn()
        && (
          resource.data.userId == request.auth.uid
          || resource.data.uid == request.auth.uid
          || isAdmin()
        );
    }

    // Knowledge Engine
    match /workspace_docs/{id} {
      allow read: if isAdmin()
        || (resource.data.workspaceId is string && isActiveMember(resource.data.workspaceId));

      allow create: if isSignedIn()
        && request.resource.data.workspaceId is string
        && roleIn(request.resource.data.workspaceId, ['owner', 'admin', 'editor'])
        && request.resource.data.ownerUid == request.auth.uid;

      allow update: if isSignedIn()
        && resource.data.workspaceId is string
        && roleIn(resource.data.workspaceId, ['owner', 'admin', 'editor'])
        && request.resource.data.workspaceId == resource.data.workspaceId;

      allow delete: if false;
    }

    match /workspace_doc_chunks/{id} {
      allow read: if isAdmin()
        || (resource.data.workspaceId is string && isActiveMember(resource.data.workspaceId));

      allow create: if isSignedIn()
        && request.resource.data.workspaceId is string
        && roleIn(request.resource.data.workspaceId, ['owner', 'admin', 'editor']);

      allow update: if isSignedIn()
        && resource.data.workspaceId is string
        && roleIn(resource.data.workspaceId, ['owner', 'admin', 'editor'])
        && request.resource.data.workspaceId == resource.data.workspaceId;

      allow delete: if false;
    }

    match /workspace_knowledge_nodes/{id} {
      allow read: if isAdmin()
        || (resource.data.workspaceId is string && isActiveMember(resource.data.workspaceId));

      allow create: if isSignedIn()
        && request.resource.data.workspaceId is string
        && roleIn(request.resource.data.workspaceId, ['owner', 'admin', 'editor']);

      allow update: if isSignedIn()
        && resource.data.workspaceId is string
        && roleIn(resource.data.workspaceId, ['owner', 'admin', 'editor'])
        && request.resource.data.workspaceId == resource.data.workspaceId;

      allow delete: if false;
    }

    match /workspace_knowledge_edges/{id} {
      allow read: if isAdmin()
        || (resource.data.workspaceId is string && isActiveMember(resource.data.workspaceId));

      allow create: if isSignedIn()
        && request.resource.data.workspaceId is string
        && roleIn(request.resource.data.workspaceId, ['owner', 'admin', 'editor']);

      allow update: if isSignedIn()
        && resource.data.workspaceId is string
        && roleIn(resource.data.workspaceId, ['owner', 'admin', 'editor'])
        && request.resource.data.workspaceId == resource.data.workspaceId;

      allow delete: if false;
    }

    // Impact / Approvals / Audit
    match /impact_proposals/{id} {
      allow read: if isAdmin()
        || (resource.data.workspaceId is string && isActiveMember(resource.data.workspaceId));

      allow create: if isSignedIn()
        && request.resource.data.workspaceId is string
        && roleIn(request.resource.data.workspaceId, ['owner', 'admin', 'editor']);

      allow update: if isSignedIn()
        && resource.data.workspaceId is string
        && roleIn(resource.data.workspaceId, ['owner', 'admin', 'editor'])
        && request.resource.data.workspaceId == resource.data.workspaceId;

      allow delete: if false;
    }

    match /proposal_approvals/{id} {
      allow read: if isAdmin()
        || (resource.data.workspaceId is string && isActiveMember(resource.data.workspaceId));

      allow create: if isSignedIn()
        && request.resource.data.workspaceId is string
        && roleIn(request.resource.data.workspaceId, ['owner', 'admin', 'editor']);

      allow update, delete: if false;
    }

    match /approval_actions/{id} {
      allow read: if isAdmin()
        || (resource.data.workspaceId is string && isActiveMember(resource.data.workspaceId));

      allow create: if isSignedIn()
        && request.resource.data.workspaceId is string
        && roleIn(request.resource.data.workspaceId, ['owner', 'admin', 'editor']);

      allow update: if isSignedIn()
        && resource.data.workspaceId is string
        && roleIn(resource.data.workspaceId, ['owner', 'admin', 'editor'])
        && request.resource.data.workspaceId == resource.data.workspaceId;

      allow delete: if false;
    }

    match /workspace_policies/{id} {
      allow read: if isAdmin()
        || (resource.data.workspaceId is string && isActiveMember(resource.data.workspaceId));

      allow create: if isSignedIn()
        && request.resource.data.workspaceId is string
        && roleIn(request.resource.data.workspaceId, ['owner', 'admin']);

      allow update: if isSignedIn()
        && resource.data.workspaceId is string
        && roleIn(resource.data.workspaceId, ['owner', 'admin'])
        && request.resource.data.workspaceId == resource.data.workspaceId;

      allow delete: if false;
    }

    match /audit_log/{id} {
      allow read: if isAdmin()
        || (resource.data.workspaceId is string && isActiveMember(resource.data.workspaceId));

      allow create: if isSignedIn()
        && request.resource.data.workspaceId is string
        && roleIn(request.resource.data.workspaceId, ['owner', 'admin', 'editor']);

      allow update, delete: if false;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
