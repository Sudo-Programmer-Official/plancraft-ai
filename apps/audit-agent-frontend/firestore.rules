rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isUser(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'superadmin'];
    }

    // users/{uid}
    match /users/{uid} {
      // Allow users to read/update their own profile; admins can read/update all
      allow read: if isUser(uid) || isAdmin();
      allow create: if isUser(uid);
      allow update: if isUser(uid) || isAdmin();
      allow delete: if isAdmin();
    }

    // preferences/{uid} — per-user doc
    match /preferences/{uid} {
      allow read, write: if isUser(uid) || isAdmin();
    }

    // tasks — owned by user via `userId` field
    match /tasks/{taskId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
    }

    // journalEntries — owned by user via `userId` field
    match /journalEntries/{entryId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
    }

    // links — owned by user via `userId` field
    match /links/{linkId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
    }

    // notifications — public announcements (read-only to public)
    match /notifications/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // blogs — public can read published; admins manage
    match /blogs/{blogId} {
      allow read: if resource.data.published == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
