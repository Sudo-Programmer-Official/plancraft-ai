rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isUser(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'superadmin'];
    }

    function memberDocId(workspaceId, uid) {
      return workspaceId + "_" + uid;
    }

    // Workspace membership lookup (workspace_members collection; id = `${workspaceId}_${uid}`)
    function workspaceMembership(workspaceId) {
      if (!isSignedIn() || workspaceId == null) return null;
      return get(/databases/$(database)/documents/workspace_members/$(memberDocId(workspaceId, request.auth.uid))).data;
    }

    function isActiveMember(workspaceId) {
      return isSignedIn()
        && workspaceId is string
        && exists(/databases/$(database)/documents/workspace_members/$(memberDocId(workspaceId, request.auth.uid)))
        && workspaceMembership(workspaceId).status == 'active';
    }

    function hasWorkspaceRole(workspaceId, roles) {
      return isActiveMember(workspaceId) && workspaceMembership(workspaceId).role in roles;
    }

    function isLegacyPersonalTask(data) {
      return !(data.workspaceId is string) && data.userId == request.auth.uid;
    }

    // users/{uid}
    match /users/{uid} {
      // Allow users to read/update their own profile; admins can read/update all
      allow read: if isUser(uid) || isAdmin();
      allow create: if isUser(uid);
      allow update: if isUser(uid) || isAdmin();
      allow delete: if isAdmin();
    }

    // preferences/{uid} — per-user doc
    match /preferences/{uid} {
      allow read, write: if isUser(uid) || isAdmin();
    }

    // tasks — shared per workspace (workspaceId required), legacy fallback to user-owned
    match /tasks/{taskId} {
      // CREATE: must target a workspace and be editor/admin; createdBy must be caller
      allow create: if isSignedIn()
        && request.resource.data.workspaceId is string
        && hasWorkspaceRole(request.resource.data.workspaceId, ['owner', 'admin', 'editor'])
        && request.resource.data.createdBy == request.auth.uid;

      // READ: workspace member (any role) OR legacy personal task owner OR admin
      allow read: if
        isAdmin()
        || (resource.data.workspaceId is string && isActiveMember(resource.data.workspaceId))
        || isLegacyPersonalTask(resource.data);

      // UPDATE: workspace admin/editor OR legacy personal task owner OR admin
      // Immutable: workspaceId and createdBy cannot change
      allow update: if
        (
          isAdmin()
          || (resource.data.workspaceId is string && hasWorkspaceRole(resource.data.workspaceId, ['owner', 'admin', 'editor']))
          || isLegacyPersonalTask(resource.data)
        )
        && request.resource.data.workspaceId == resource.data.workspaceId
        && request.resource.data.createdBy == resource.data.createdBy;

      // DELETE: admin, or workspace owner/admin, or legacy owner
      allow delete: if
        isAdmin()
        || (resource.data.workspaceId is string && hasWorkspaceRole(resource.data.workspaceId, ['owner', 'admin']))
        || isLegacyPersonalTask(resource.data);
    }

    // journalEntries — owned by user via `userId` field
    match /journalEntries/{entryId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
    }

    // links — owned by user via `userId` field
    match /links/{linkId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
    }

    // notifications — public announcements (read-only to public)
    match /notifications/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // blogs — public can read published; admins manage
    match /blogs/{blogId} {
      allow read: if resource.data.published == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
