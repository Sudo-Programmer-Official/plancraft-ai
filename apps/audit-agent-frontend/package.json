    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "postcss": "^8.5.4",
    "prettier": "3.5.3",
    "sharp": "^0.34.4",
    "vite": "^6.2.4",
    "vite-plugin-pwa": "^1.0.3",
    "vite-plugin-vue-devtools": "^7.7.2",
    "vite-ssg": "^0.24.1"
