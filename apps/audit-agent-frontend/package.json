{
  "name": "audit-agent-frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --mode development",
    "build": "vite build --mode production && node scripts/generate-sitemap.js",
    "build:dev": "vite build --mode development && node -r dotenv/config scripts/generate-sitemap.js",
    "build:ssg": "vite-ssg build src/main-ssg.js",
    "preview": "vite preview",
    "deploy": "npm run build && firebase deploy",
    "lint": "eslint . --fix",
    "format": "prettier --write src/",
    "test:tz": "node scripts/test-timezones.mjs",
    "tw:init": "tailwindcss init -p"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@dataconnect/generated": "file:src/dataconnect-generated",
