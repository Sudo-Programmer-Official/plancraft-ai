    "@fontsource/poppins": "^5.2.6",
    "@stripe/stripe-js": "^8.0.0",
    "@tailwindcss/postcss": "^4.1.8",
    "@tailwindcss/vite": "^4.1.8",
    "@vueuse/core": "^13.9.0",
    "@vueuse/head": "^2.0.0",
    "aos": "^2.3.4",
    "axios": "^1.9.0",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "dayjs": "^1.11.11",
    "docx": "^9.5.0",
    "driver.js": "^1.3.6",
    "element-plus": "^2.10.0",
    "file-saver": "^2.0.5",
    "firebase": "^11.9.0",
    "html-docx-js": "^0.3.1",
    "jspdf": "^3.0.1",
    "jszip": "^3.10.1",
    "libphonenumber-js": "^1.12.24",
    "markdown-it": "^14.1.0",
    "mixpanel-browser": "^2.70.0",
    "pinia": "^3.0.1",
    "recordrtc": "^5.6.2",
    "sass": "^1.89.1",
    "sortablejs": "^1.15.3",
    "tailwindcss": "^4.1.8",
    "vite-plugin-pages": "^0.33.0",
    "vue": "^3.5.13",
    "vue-gtag": "^3.5.1",
    "vue-router": "^4.5.0",
    "vuedraggable": "^4.1.0",
    "workbox-window": "^7.3.0"
