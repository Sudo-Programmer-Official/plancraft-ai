default_platform(:ios)

def mobile_root
  File.expand_path("..", __dir__)
end

def repo_root
  File.expand_path("..", mobile_root)
end

def frontend_root
  File.join(repo_root, "apps", "audit-agent-frontend")
end

def app_store_api_key_from_env
  key_id = ENV["APP_STORE_CONNECT_API_KEY_ID"]
  issuer_id = ENV["APP_STORE_CONNECT_ISSUER_ID"]
  key_content = ENV["APP_STORE_CONNECT_API_KEY_CONTENT"]
  key_path = ENV["APP_STORE_CONNECT_API_KEY_PATH"]

  return nil if key_id.to_s.empty? || issuer_id.to_s.empty? || (key_content.to_s.empty? && key_path.to_s.empty?)

  api_key_options = {
    key_id: key_id,
    issuer_id: issuer_id,
    is_key_content_base64: ENV["APP_STORE_CONNECT_API_KEY_IS_BASE64"] == "1",
    duration: 1200,
  }
  api_key_options[:key_content] = key_content unless key_content.to_s.empty?
  api_key_options[:key_filepath] = key_path unless key_path.to_s.empty?

  app_store_connect_api_key(**api_key_options)
end

def effective_build_number(api_key)
  app_identifier = ENV.fetch("IOS_APP_IDENTIFIER", "com.sudoprogrammer.plancraftai")
  local_build = get_build_number(xcodeproj: "ios/App/App.xcodeproj").to_i
  requested_build = ENV["IOS_BUILD_NUMBER"].to_i
  remote_build = local_build

  if api_key
    begin
      remote_build = latest_testflight_build_number(
        app_identifier: app_identifier,
        api_key: api_key,
        initial_build_number: local_build,
      ).to_i
    rescue => error
      UI.important("Could not read latest TestFlight build number: #{error.message}")
    end
  end

  [local_build + 1, remote_build + 1, requested_build].max
end

platform :ios do
  desc "Build the Capacitor iOS app and upload it to TestFlight"
  lane :beta do |options|
    api_key = app_store_api_key_from_env
    changelog = options[:changelog] || ENV["TESTFLIGHT_CHANGELOG"] || "Bug fixes and improvements"

    unless ENV["SKIP_FRONTEND_BUILD"] == "1"
      Dir.chdir(frontend_root) do
        sh("npm run build")
      end
    end

    Dir.chdir(mobile_root) do
      sh("npx cap sync ios")
    end

    build_number = effective_build_number(api_key)
    increment_build_number(
      xcodeproj: "ios/App/App.xcodeproj",
      build_number: build_number,
    )

    build_app(
      project: "ios/App/App.xcodeproj",
      scheme: "App",
      export_method: "app-store",
      clean: true,
      output_directory: "build/ios",
      output_name: "PlanCraftAI.ipa",
      xcargs: "-allowProvisioningUpdates",
      export_xcargs: "-allowProvisioningUpdates",
      export_options: {
        signingStyle: "automatic",
      },
    )

    upload_to_testflight(
      api_key: api_key,
      ipa: "build/ios/PlanCraftAI.ipa",
      changelog: changelog,
      skip_waiting_for_build_processing: true,
    )
  end
end
