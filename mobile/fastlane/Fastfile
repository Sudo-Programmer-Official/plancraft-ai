require "base64"
require "fileutils"
require "json"
require "shellwords"

default_platform(:ios)

def mobile_root
  File.expand_path("..", __dir__)
end

def repo_root
  File.expand_path("..", mobile_root)
end

def frontend_root
  File.join(repo_root, "apps", "audit-agent-frontend")
end

def normalized_app_store_key_content(raw_key_content)
  value = raw_key_content.to_s.strip
  return nil if value.empty?

  if (value.start_with?('"') && value.end_with?('"')) || (value.start_with?("'") && value.end_with?("'"))
    value = value[1..-2]
  end

  value = value.gsub("\\n", "\n").gsub("\r\n", "\n").gsub("\r", "\n")

  unless value.include?("BEGIN PRIVATE KEY")
    begin
      decoded = Base64.strict_decode64(value.gsub(/\s+/, ""))
      value = decoded if decoded.include?("BEGIN PRIVATE KEY")
    rescue ArgumentError
      nil
    end
  end

  value = value.gsub("\r\n", "\n").gsub("\r", "\n")
  value = "#{value}\n" unless value.end_with?("\n")

  unless value.include?("BEGIN PRIVATE KEY") && value.include?("END PRIVATE KEY")
    UI.user_error!(
      "App Store Connect API key content is malformed. Provide APP_STORE_CONNECT_API_KEY_CONTENT as the full .p8 content, an escaped \\n string, or a base64-encoded .p8 file."
    )
  end

  value
end

def materialized_app_store_key_path(raw_key_content)
  key_file = File.join(mobile_root, "build", "fastlane", "AuthKey.p8")
  FileUtils.mkdir_p(File.dirname(key_file))
  File.write(key_file, normalized_app_store_key_content(raw_key_content))
  key_file
end

def app_store_api_key_path_from_env
  key_content = ENV["APP_STORE_CONNECT_API_KEY_CONTENT"]
  key_path = ENV["APP_STORE_CONNECT_API_KEY_PATH"]
  return nil if key_path.to_s.empty? && key_content.to_s.empty?

  key_path.to_s.empty? ? materialized_app_store_key_path(key_content) : key_path
end

def shared_version_name
  version_file = File.join(repo_root, "version.json")
  version_data = JSON.parse(File.read(version_file))
  version = version_data["version"].to_s.strip
  UI.user_error!("version.json must include a non-empty version field") if version.empty?
  version
end

def app_store_api_key_from_env
  key_id = ENV["APP_STORE_CONNECT_API_KEY_ID"]
  issuer_id = ENV["APP_STORE_CONNECT_ISSUER_ID"]
  resolved_key_path = app_store_api_key_path_from_env

  return nil if key_id.to_s.empty? || issuer_id.to_s.empty? || resolved_key_path.to_s.empty?

  api_key_options = {
    key_id: key_id,
    issuer_id: issuer_id,
    key_filepath: resolved_key_path,
    duration: 1200,
  }

  app_store_connect_api_key(**api_key_options)
end

def xcode_cloud_signing_xcargs
  key_path = app_store_api_key_path_from_env
  key_id = ENV["APP_STORE_CONNECT_API_KEY_ID"].to_s.strip
  issuer_id = ENV["APP_STORE_CONNECT_ISSUER_ID"].to_s.strip

  args = ["-allowProvisioningUpdates"]

  if !key_path.to_s.empty? && !key_id.empty? && !issuer_id.empty?
    args << "-authenticationKeyPath #{Shellwords.escape(key_path)}"
    args << "-authenticationKeyID #{Shellwords.escape(key_id)}"
    args << "-authenticationKeyIssuerID #{Shellwords.escape(issuer_id)}"
  end

  args.join(" ")
end

def effective_build_number(api_key)
  app_identifier = ENV.fetch("IOS_APP_IDENTIFIER", "com.sudoprogrammer.plancraftai")
  local_build = get_build_number(xcodeproj: "ios/App/App.xcodeproj").to_i
  requested_build = ENV["IOS_BUILD_NUMBER"].to_i
  remote_build = local_build

  if api_key
    begin
      remote_build = latest_testflight_build_number(
        app_identifier: app_identifier,
        api_key: api_key,
        initial_build_number: local_build,
      ).to_i
    rescue => error
      UI.important("Could not read latest TestFlight build number: #{error.message}")
    end
  end

  [local_build + 1, remote_build + 1, requested_build].max
end

platform :ios do
  desc "Build the Capacitor iOS app and upload it to TestFlight"
  lane :beta do |options|
    setup_ci if ENV["CI"]

    api_key = app_store_api_key_from_env
    changelog = options[:changelog] || ENV["TESTFLIGHT_CHANGELOG"] || "Bug fixes and improvements"
    signing_xcargs = xcode_cloud_signing_xcargs

    unless ENV["SKIP_FRONTEND_BUILD"] == "1"
      Dir.chdir(frontend_root) do
        sh("npm run build")
      end
    end

    Dir.chdir(mobile_root) do
      sh("npx cap sync ios")
    end

    build_number = effective_build_number(api_key)
    increment_version_number(
      xcodeproj: "ios/App/App.xcodeproj",
      version_number: shared_version_name,
    )
    increment_build_number(
      xcodeproj: "ios/App/App.xcodeproj",
      build_number: build_number,
    )

    build_app(
      project: "ios/App/App.xcodeproj",
      scheme: "App",
      export_method: "app-store",
      clean: true,
      skip_profile_detection: true,
      output_directory: "build/ios",
      output_name: "PlanCraftAI.ipa",
      xcargs: signing_xcargs,
      export_xcargs: signing_xcargs,
      export_options: {
        method: "app-store-connect",
        destination: "export",
        signingStyle: "automatic",
        teamID: ENV["IOS_DEVELOPER_TEAM_ID"],
        uploadSymbols: true,
        manageAppVersionAndBuildNumber: false,
      },
    )

    upload_to_testflight(
      api_key: api_key,
      ipa: "build/ios/PlanCraftAI.ipa",
      changelog: changelog,
      skip_waiting_for_build_processing: true,
    )
  end
end
