VITE_ENABLE_TEAMS=true
# Kill switch: disable offline SMS fallback (keeps email/whatsapp/voice enabled)
ENABLE_OFFLINE_MESSAGES=false
VITE_ENABLE_OFFLINE_MESSAGES=false

# Example server env (for server/app.example.js)
# Base64 of Firebase service account JSON (recommended for staging/local)
# FIREBASE_SERVICE_ACCOUNT_BASE64=

# CORS origin for the frontend app (e.g., http://localhost:5173)
# CORS_ORIGIN=

# Server port
# PORT=3000

# Optional: Frontend API base URL (prefix for /api requests)
# VITE_API_BASE_URL=http://localhost:3000

# Optional: LLM provider configuration (Sprint 3 placeholder)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_API_BASE=https://api.openai.com/v1/chat/completions

# Automation processing mode (sync | queue), defaults to sync
# AUTOMATION_MODE=sync

# Optional: automation log retention in days (used by cron script)
# AUTOMATION_LOG_RETENTION_DAYS=30

# --- Outlook Calendar Integration (backend) ---
# Set to 1 after Azure app registration is configured
ENABLE_OUTLOOK_CALENDAR=0
# Azure App registration credentials
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
# Redirect URI configured in Azure (use localhost for dev)
OUTLOOK_REDIRECT_URI=http://localhost:4000/outlook/oauth/callback
# Optional UI redirects (fallbacks use APP_SUCCESS_URL/APP_FAILURE_URL)
OUTLOOK_CONNECT_REDIRECT_SUCCESS=http://localhost:5173/settings?outlook=connected
OUTLOOK_CONNECT_REDIRECT_FAILURE=http://localhost:5173/settings?outlook=error
# Sync cadence for server cron (cron syntax)
OUTLOOK_SYNC_CRON=*/10 * * * *

# --- Discord Integration (reminders/notifications)
# Flip on after creating a Discord app + bot in the Developer Portal
ENABLE_DISCORD=0
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_REDIRECT_URI=http://localhost:4000/discord/oauth/callback
DISCORD_CONNECT_REDIRECT_SUCCESS=http://localhost:5173/settings?integration=discord&status=success
DISCORD_CONNECT_REDIRECT_FAILURE=http://localhost:5173/settings?integration=discord&status=error
