## Firebase (service account)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=service-account-email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n....\n-----END PRIVATE KEY-----\n"
# Optional: use the full JSON blob instead of the three vars above
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"","private_key_id":"","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"","client_id":""}

## Core service auth / CORS
SERVICE_APP_TOKEN=your-shared-app-token
ALLOW_ANON=0
CORS_ALLOW_ALL=1
ALLOWED_ORIGINS=https://plancraftai.com,http://localhost:5173

## LinkedIn OAuth
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret
LINKEDIN_REDIRECT_URL=https://cynhej3glnv.us-west-2.awsapprunner.com/auth/linkedin/callback
LINKEDIN_REDIRECT_URL_LOCAL=http://localhost:4004/auth/linkedin/callback
LINKEDIN_ORG_ID=your-linkedin-org-id
LINKEDIN_STATE_SECRET=change-me
LINKEDIN_SUCCESS_REDIRECT=https://plancraftai.com/auth/linkedin/success
LINKEDIN_ERROR_REDIRECT=https://plancraftai.com/auth/linkedin/error

## Instagram / Facebook OAuth (requires Meta App ID)
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
INSTAGRAM_REDIRECT_URL=https://your-domain.com/auth/instagram/callback
INSTAGRAM_SCOPES=instagram_basic,instagram_content_publish,pages_show_list,pages_read_engagement

## Instagram Graph (not used for OAuth)
INSTAGRAM_APP_ID=your-instagram-app-id
INSTAGRAM_APP_SECRET=your-instagram-app-secret
META_PAGE_ID=your-meta-page-id

## Twitter / X
TWITTER_CLIENT_ID=your-twitter-client-id
TWITTER_CLIENT_SECRET=your-twitter-client-secret
TWITTER_REDIRECT_URL=https://your-domain.com/auth/twitter/callback
TWITTER_SCOPES=tweet.read,tweet.write,users.read,offline.access
TWITTER_BEARER_TOKEN=your-twitter-bearer-token

## OAuth shared
OAUTH_STATE_SECRET=change-me
OAUTH_STATE_TTL_SECONDS=900
SOCIAL_CONNECT_REDIRECT_SUCCESS=https://plancraftai.com/social/connect/success
SOCIAL_CONNECT_REDIRECT_ERROR=https://plancraftai.com/social/connect/error

## Facebook (for Instagram publishing)
FB_PAGE_ACCESS_TOKEN=your-facebook-page-access-token

PORT=8080
