# Goals service configuration
GOALS_SERVICE_PORT=4502
GOALS_SERVICE_ALLOWED_ORIGINS=http://localhost:5173
# Firebase Admin credentials
# Provide either FIREBASE_SERVICE_ACCOUNT (JSON string) or GOALS_FIREBASE_CREDENTIAL_PATH
FIREBASE_SERVICE_ACCOUNT=
GOALS_FIREBASE_CREDENTIAL_PATH=../backend-node/firebase-service-account.json
FIREBASE_PROJECT_ID=

# OpenAI keys for milestone generation
OPENAI_API_KEY=
GOALS_OPENAI_MODEL=gpt-3.5-turbo

# Optional: existing task service endpoint to auto-create milestone tasks
GOALS_TASK_SERVICE_URL=http://localhost:4000/api/tasks/create
