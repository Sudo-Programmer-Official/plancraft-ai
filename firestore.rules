rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    function isMember(orgId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/orgs/$(orgId)/members/$(request.auth.uid));
    }

    function memberDoc(orgId) {
      return get(/databases/$(database)/documents/orgs/$(orgId)/members/$(request.auth.uid));
    }

    function role(orgId) {
      return memberDoc(orgId).data.role;
    }

    function isAdminOrOwner(orgId) {
      return role(orgId) == 'owner' || role(orgId) == 'admin';
    }

    // Allow initial owner to create their membership once, during bootstrap
    function isOrgOwnerBootstrap(orgId, uid) {
      return request.auth != null &&
        uid == request.auth.uid &&
        get(/databases/$(database)/documents/orgs/$(orgId)).data.ownerUid == request.auth.uid &&
        request.resource.data.role == 'owner' &&
        !exists(/databases/$(database)/documents/orgs/$(orgId)/members/$(uid));
    }

    // org root
    match /orgs/{orgId} {
      allow read: if isMember(orgId);
      allow create: if signedIn();
      allow update, delete: if role(orgId) in ['owner', 'admin'];

      // members
      match /members/{uid} {
        allow read: if isMember(orgId);
        // Allow admins, or strict owner bootstrap (first owner self-membership)
        allow create: if isAdminOrOwner(orgId) || isOrgOwnerBootstrap(orgId, uid);
        allow update, delete: if role(orgId) == 'owner' || (role(orgId) == 'admin' && uid != request.auth.uid);
      }

      // projects
      match /projects/{projectId} {
        allow read: if isMember(orgId);
        allow create, update, delete: if isMember(orgId);
      }

      // boards
      match /boards/{boardId} {
        allow read: if isMember(orgId);
        allow create, update, delete: if isMember(orgId);
      }

      // tasks
      match /tasks/{taskId} {
        function previousAssignees() {
          return resource.data.assignees != null ? resource.data.assignees : [];
        }

        function nextAssignees() {
          return request.resource.data.assignees != null ? request.resource.data.assignees : [];
        }

        function isSelfAssignedArray() {
          return request.auth != null &&
            ((resource.data.assignees != null && request.auth.uid in resource.data.assignees) ||
             (request.resource.data.assignees != null && request.auth.uid in request.resource.data.assignees));
        }

        allow read: if isMember(orgId);
        allow create: if isMember(orgId);
        allow update: if isMember(orgId) && (
          isAdminOrOwner(orgId) ||
          isSelfAssignedArray() ||
          (
            previousAssignees().size() == 0 &&
            nextAssignees().size() == 1 &&
            request.auth.uid in nextAssignees()
          )
        );
        allow delete: if isAdminOrOwner(orgId);
      }

      match /projects/{projectId}/tasks/{taskId} {
        function currentAssignee() {
          return resource.data.assignedTo;
        }

        function nextAssignee() {
          return request.resource.data.assignedTo;
        }

        function isSelfAssignee() {
          return request.auth != null && (
            currentAssignee() == request.auth.uid ||
            nextAssignee() == request.auth.uid
          );
        }

        allow read: if isMember(orgId);
        allow create: if isMember(orgId);
        allow update: if isMember(orgId) && (
          isAdminOrOwner(orgId) ||
          isSelfAssignee() ||
          (currentAssignee() == null && nextAssignee() == request.auth.uid)
        );
        allow delete: if isAdminOrOwner(orgId);

        match /updates/{updateId} {
          allow read: if isMember(orgId);
          allow create: if isMember(orgId) && (
            isAdminOrOwner(orgId) ||
            (request.resource.data.uid != null && request.resource.data.uid == request.auth.uid)
          );
          allow update, delete: if false;
        }
      }

      match /meetings/{meetingId} {
        allow read: if isMember(orgId);
        allow create: if isMember(orgId);
        allow update: if isMember(orgId);
        allow delete: if isAdminOrOwner(orgId);

        match /recordings/{recordingId} {
          allow read: if isMember(orgId);
          allow create: if isMember(orgId);
          allow update: if isMember(orgId);
          allow delete: if isAdminOrOwner(orgId);
        }
      }

      match /vault/{itemId} {
        allow read: if isMember(orgId);
        allow create, update, delete: if isAdminOrOwner(orgId);
      }

      match /invites/{inviteId} {
        allow read, write: if isAdminOrOwner(orgId);
      }

      // automation logs
      match /automationLogs/{logId} {
        allow read: if isMember(orgId);
        allow create: if isAdminOrOwner(orgId);
        allow update, delete: if false; // logs are append-only
      }

      match /chatRooms/{roomId} {
        allow read: if isMember(orgId);
        allow create: if isMember(orgId);
        allow update: if isMember(orgId);
        allow delete: if isAdminOrOwner(orgId);

        match /messages/{messageId} {
          allow read: if isMember(orgId);
          allow create: if isMember(orgId) && request.auth != null && request.auth.uid == request.resource.data.senderUid;
          allow update: if isMember(orgId) && request.auth != null;
          allow delete: if isAdminOrOwner(orgId);
        }

        match /insights/{insightId} {
          allow read: if isMember(orgId);
          allow create: if isMember(orgId);
          allow update: if isAdminOrOwner(orgId);
          allow delete: if isAdminOrOwner(orgId);
        }
      }

      match /rtcRooms/{roomId} {
        allow read: if isMember(orgId);
        allow create, update, delete: if isMember(orgId);
      }
    }

    match /waitlist_teams/{waitlistId} {
      allow read: if false;
      allow write: if false;
    }
  }
}
