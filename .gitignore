# Root .gitignore for Prompt2 Monorepo

# Node
node_modules/
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# Logs
logs/
*.log
*.log.*

# Environment
.env
.env.*
.env.local

# Vite
dist/
.cache/
.vite/
*.local

# Mac system files
.DS_Store

# IDEs
.vscode/
.idea/
*.sw?

# Output
*.zip
*.tgz
coverage/
build/

# Firebase (if added)
.firebase/
.firebaserc

# Temporary
tmp/
temp/
*.tmp
*.temp

/apps/backend-node/firebase-service-account.json

# VS Code settings
*.code-workspace

# Tailwind CSS build artifacts
# tailwind.config.js
# postcss.config.js
# prettier.config.js

# Python cache (if ever used in shared utils)
__pycache__/
*.py[cod]

# Optional: Ignore backend uploads/data folders
# apps/backend-node/uploads/
# apps/backend-node/node_modules/
# apps/backend-node/results_*.json
# apps/backend-node/results_*.csv

# Ignore ALL node_modules in monorepo (root, apps, shared)
# **/node_modules/
# node_modules/
# apps/*/node_modules/
# shared/*/node_modules/

