# Root .gitignore for Prompt2 Monorepo

# -----------------------------
# OS / Editor
# -----------------------------
.DS_Store
.AppleDouble
.LSOverride

.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json

*.sw?
*.iml
*.code-workspace

# -----------------------------
# Logs
# -----------------------------
logs/
*.log
*.log.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
firebase-debug.log

# -----------------------------
# Dependencies / Package managers
# -----------------------------
node_modules/
.pnpm-store/

# Monorepo nested dependencies
apps/**/node_modules/
dev-toolkit/**/node_modules/

# -----------------------------
# Environment / secrets
# -----------------------------
.env
.env.*
!.env.example
.env.local
.env.*.local
.env.test
.env.test.local
.envrc
.direnv/

# Explicit local secret files
/apps/backend-node/firebase-service-account.json
/apps/audit-agent-frontend/scripts/firebase-service-account.json
/apps/audit-agent-frontend/firebase-service-account.json
/apps/backend-node/keys/*

# General secret/key files
**/firebase-service-account.json
**/*service-account*.json
*.pem
*.p12
*.key
*.crt

# -----------------------------
# Build / output artifacts
# -----------------------------
dist/
build/
lib/
out/
coverage/
storybook-static/
.cache/
.tmp/
.temp/
tmp/
temp/
*.tmp
*.temp
*.zip
*.tgz

# Monorepo nested build artifacts
apps/**/dist/
apps/**/build/
apps/**/coverage/
dev-toolkit/**/dist/

# Framework caches
.next/
.nuxt/
.vite/
.svelte-kit/
.angular/
.vuepress/dist
.vitepress/dist

# Testing / coverage
.nyc_output/
cypress/screenshots/
cypress/videos/
playwright-report/
test-results/

# Tool caches
.turbo/
.nx/
.eslintcache
.stylelintcache

# -----------------------------
# Python
# -----------------------------
__pycache__/
*.py[cod]
*.pyc
.python-version

# -----------------------------
# Firebase / local cloud tooling
# -----------------------------
.firebase/
.firebaserc
.config/
.credentials/

# -----------------------------
# Google Cloud SDK / CLI artifacts
# -----------------------------
google-cloud-sdk/
bq.*
core.*
gcloud.*
gsutil.*
*.manifest.json
*.snapshot.json
*.crc32c
*.install
*.deps.json

# -----------------------------
# Local shell/setup scripts
# -----------------------------
fix_cors.sh
setup_env.sh

# -----------------------------
# Capacitor / Android
# -----------------------------
mobile/android/.gradle/
mobile/android/build/
mobile/android/**/build/
mobile/android/local.properties
mobile/android/keystore.properties
mobile/android/capacitor-cordova-android-plugins/
mobile/android/app/src/main/assets/public/
mobile/android/app/src/main/assets/capacitor.config.json
mobile/android/app/src/main/assets/capacitor.plugins.json

# -----------------------------
# Capacitor / iOS
# -----------------------------
mobile/ios/Pods/
mobile/ios/build/
mobile/ios/capacitor-cordova-ios-plugins/
mobile/ios/App/App/public/
mobile/ios/App/App/capacitor.config.json
mobile/ios/App/App/capacitor.plugins.json

# Xcode user-specific
mobile/ios/App/App.xcworkspace/xcuserdata/
mobile/ios/App/xcuserdata/
mobile/ios/**/*.xcuserstate

# CocoaPods
mobile/ios/App/Pods/
mobile/ios/App/Podfile.lock
mobile/build/ios/
mobile/fastlane/Preview.html
mobile/fastlane/report.xml
mobile/fastlane/screenshots/
mobile/fastlane/test_output/

# -----------------------------
# Optional app data ignores
# -----------------------------
# apps/backend-node/uploads/
# apps/backend-node/results_*.json
# apps/backend-node/results_*.csv
apps/audit-agent-frontend/public/release.json
