# Root .gitignore for Prompt2 Monorepo

# Node
node_modules/
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# Logs
logs/
*.log
*.log.*

# Environment
.env
.env.*
.env.local

# Vite
dist/
.cache/
.vite/
*.local

# Mac system files
.DS_Store

# IDEs
.vscode/
.idea/
*.sw?

# Output
*.zip
*.tgz
coverage/
build/

# Firebase (if added)
.firebase/
.firebaserc

# Temporary
tmp/
temp/
*.tmp
*.temp

/apps/backend-node/firebase-service-account.json
/apps/audit-agent-frontend/scripts/firebase-service-account.json
/apps/audit-agent-frontend/firebase-service-account.json

# VS Code settings
*.code-workspace

# Tailwind CSS build artifacts
# tailwind.config.js
# postcss.config.js
# prettier.config.js

# Python cache (if ever used in shared utils)
__pycache__/
*.py[cod]

# Optional: Ignore backend uploads/data folders
# apps/backend-node/uploads/
# apps/backend-node/node_modules/
# apps/backend-node/results_*.json
# apps/backend-node/results_*.csv

# Ignore ALL node_modules in monorepo (root, apps, shared)
# **/node_modules/
# node_modules/
# apps/*/node_modules/
# shared/*/node_modules/
### Monorepo ignores (appended)
# OS / Editor
.DS_Store
.AppleDouble
.LSOverride
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json

# Package managers / logs
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# Build outputs
dist/
build/
lib/
out/
storybook-static/
.cache/
.tmp/
.temp/

# Framework caches
.next/
.nuxt/
.vite/
.svelte-kit/
.angular/
.vuepress/dist
.vitepress/dist

# Testing / coverage
coverage/
.nyc_output/
cypress/screenshots/
cypress/videos/
playwright-report/
test-results/

# Tool caches
.turbo/
.nx/
.eslintcache
.stylelintcache

# Monorepo nested artifacts
apps/**/node_modules/
apps/**/dist/
apps/**/.next/
apps/**/.nuxt/
apps/**/.vite/
apps/**/coverage/
apps/**/build/
dev-toolkit/**/node_modules/
dev-toolkit/**/dist/

# Environment files (local variants only)
.env.local
.env.*.local
.env.test
.env.test.local
.envrc
.direnv/
# If you intentionally commit canonical env files, keep them tracked:
#!.env
#!.env.development
#!.env.production

# Firebase / secrets
firebase-debug.log
.firebase/
**/firebase-service-account.json
**/*service-account*.json

# Keys (general)
*.pem
*.p12
*.key
*.crt


# --- Google Cloud SDK / CLI Artifacts ---
google-cloud-sdk/
bin/
install/
bq.*
core.*
gcloud.*
gsutil.*
*.manifest.json
*.snapshot.json
*.crc32c
*.install
*.deps.json

# --- Firebase / gcloud local configs ---
.config/
.cache/
.credentials/
.python-version
*.pyc

# --- Local shell & setup scripts ---
fix_cors.sh
setup_env.sh